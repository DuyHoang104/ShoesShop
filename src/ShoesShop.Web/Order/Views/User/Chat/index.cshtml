@using ShoesShop.Web.Modules.Users.Order.Dtos.Commands
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model ChatModalDto

@{
    ViewData["Title"] = "Chat Center";
    Layout = "~/Shares/Views/User/_Layout.cshtml";
}

<link rel="stylesheet" href="~/assets/product/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/assets/product/css/style.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
:root { --glass-bg:rgba(17,18,20,.85); --glass-border:rgba(255,255,255,.08); --accent-glow:linear-gradient(135deg,#00d2ff 0%,#3a7bd5 100%); --text-secondary:#94a3b8; --black:#000000; }
.chat-wrapper { margin-top:100px; padding-bottom:50px; max-width:1400px; margin-inline:auto; }
.chat-master-container { display:flex; height:82vh; background:var(--glass-bg); backdrop-filter:blur(25px); -webkit-backdrop-filter:blur(25px); border:1px solid var(--glass-border); border-radius:30px; overflow:hidden; box-shadow:0 40px 100px rgba(0,0,0,.6); }
.chat-sidebar { width:320px; background:var(--black); border-right:1px solid var(--glass-border); display:flex; flex-direction:column; }
.sidebar-brand { padding:30px; font-size:22px; font-weight:700; background:var(--accent-glow); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
.order-list-title { padding:10px 30px; font-size:11px; text-transform:uppercase; letter-spacing:2px; color:var(--text-secondary); }
.order-item { margin:5px 15px; padding:18px; border-radius:20px; transition:all .4s cubic-bezier(0.4,0,0.2,1); cursor:pointer; display:flex; align-items:center; gap:15px; border:1px solid transparent; }
.order-item.active { background:rgba(255,255,255,.03); border:1px solid rgba(255,255,255,.1); box-shadow:0 10px 30px rgba(0,0,0,.2); }
.order-icon { width:45px; height:45px; background:#1a1b1e; border-radius:12px; display:flex; align-items:center; justify-content:center; color:#00d2ff; font-size:18px; }
.order-item.active .order-icon { background:var(--accent-glow); color:white; }
.chat-main { flex:1; display:flex; flex-direction:column; }
.chat-main-header { padding:20px 40px; display:flex; align-items:center; justify-content:space-between; background:var(--black); border-bottom:1px solid var(--glass-border); }
.header-status { display:flex; align-items:center; gap:12px; }
.pulse-dot { width:10px; height:10px; background:#10b981; border-radius:50%; position:relative; }
.pulse-dot::after { content:""; position:absolute; width:100%; height:100%; background:#10b981; border-radius:50%; animation:pulse 2s infinite; }
@@keyframes pulse { 0% { transform:scale(1); opacity:.8; } 100% { transform:scale(2.5); opacity:0; } }
@@media (max-width:992px) { .chat-master-container { flex-direction:column; height:auto; border-radius:20px; } .chat-sidebar { width:100%; flex-direction:row; overflow-x:auto; border-right:none; border-bottom:1px solid var(--glass-border); } .order-item { flex:0 0 auto; } .chat-main { padding:10px; } .chat-main-header { padding:15px 20px; } .chat-message { max-width:80%; } }
@@media (max-width:576px) { .chat-main-header h6 { font-size:14px; } .sidebar-brand { font-size:18px; padding:15px; } }
</style>
<section class="breadcrumb breadcrumb_bg">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="breadcrumb_iner">
                    <div class="breadcrumb_iner_item">
                        <h2>Completed</h2>
                        <p>Home <span>-</span> Order Completed</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="chat-wrapper">
    <div class="chat-master-container">
        <div class="chat-sidebar">
            <div class="sidebar-brand">ShoeShop Hub</div>
            <div class="order-list-title">My Orders</div>
            <div class="order-item active">
                <div class="order-icon"><i class="bi bi-box-seam"></i></div>
                <div>
                    <div style="font-weight: 600; font-size: 15px;">Order #@Model.OrderId</div>
                    <div style="font-size: 12px; color: var(--text-secondary);">Active Support</div>
                </div>
            </div>
        </div>

        <div class="chat-main">
            <div class="chat-main-header">
                <div class="header-status">
                    <div class="pulse-dot"></div>
                    <div>
                        <h6 class="m-0" style="font-weight: 700; color: var(--text-primary);">Customer Care</h6>
                        <small style="color: var(--text-secondary)">Online</small>
                    </div>
                </div>
                <div class="header-utils">
                    <i class="bi bi-shield-check" style="color: #00d2ff; font-size: 20px;"></i>
                </div>
            </div>

            @await Html.PartialAsync(partialViewName: "~/Order/Views/User/Chat/Chat-area.cshtml", Model)
        </div>
    </div>
</div>