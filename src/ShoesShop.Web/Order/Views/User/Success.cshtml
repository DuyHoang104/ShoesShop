@using ShoesShop.Domain.Orders.Enums
@using ShoesShop.Web.Modules.Users.Order.Dtos.Commands
@using ShoesShop.Web.Order.Dtos.User.Commands
@model OrderDetailModalDto

@inject Microsoft.Extensions.Options.IOptions<CloudinarySettings> CloudinaryConfig

@{
    Layout = "~/Shares/Views/User/_Layout.cshtml";

    var subtotal = Model.OrderDetails.Sum(x => x.Subtotal);
    var shipping = Model.ShippingCost ?? 0;
    var discountPercent = (Model.DiscountValue ?? 0) * 100;
    var discountAmount = subtotal * (Model.DiscountValue ?? 0);
    var total = subtotal + shipping - discountAmount;

    var paymentBadgeClass = Model.PaymentStatus == PaymentStatus.Unpaid
    ? "badge-unpaid"
    : "badge-paid";
}

<link rel="stylesheet" href="~/assets/product/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/assets/product/css/style.css">

<style>
:root { --bg-main:#0e0f13; --bg-card:#161822; --bg-soft:#1f2230; --black:#000; --border-soft:#2b2f40; --text-main:#fff; --text-muted:#9aa0b4; --success:#22c55e; --warning:#f59e0b; --danger:#ef4444; }
.container { margin-top:50px; }
.order-dark { padding:70px 0; }
.order-header { text-align:center; margin-bottom:50px; }
.order-header h1 { font-size:32px; font-weight:800; }
.order-header p { color:var(--text-muted); font-size:18px; }
.dark-card { background:black; border-radius:18px; padding:26px; border:1px solid var(--black); box-shadow:0 20px 50px rgba(0,0,0,.45); }
.dark-title { font-size:18px; font-weight:700; margin-bottom:18px; }
.info-row { display:grid; grid-template-columns:1fr auto; align-items:center; padding:12px 0; border-bottom:1px dashed var(--border-soft); }
.info-row:last-child { border-bottom:none; }
.badge-status { display:inline-flex; align-items:center; justify-content:center; width:fit-content; padding:6px 14px; border-radius:999px; font-size:13px; font-weight:600; white-space:nowrap; text-align:right; }
.badge-paid { background:rgba(34,197,94,.15); color:var(--success); }
.badge-unpaid { background:rgba(245,158,11,.15); color:var(--warning); }
.order-table { width:100%; table-layout:fixed; border-collapse:collapse; }
.order-table th { color:var(--text-muted); font-size:12px; text-transform:uppercase; padding:14px 12px; border-bottom:1px solid var(--border-soft); text-align:left; }
.order-table td { padding:18px 12px; font-size:14px; vertical-align:middle; }
.order-table th:nth-child(1), .order-table td:nth-child(1) { width:10%; }
.order-table th:nth-child(2), .order-table td:nth-child(2) { width:30%; }
.order-table th:nth-child(3), .order-table td:nth-child(3) { width:10%; }
.order-table th:nth-child(4), .order-table td:nth-child(4) { width:10%; text-align:center; }
.order-table th:nth-child(5), .order-table td:nth-child(5), .order-table th:nth-child(6), .order-table td:nth-child(6) { width:20%; text-align:right; }
.order-table img { width:72px; height:72px; border-radius:12px; object-fit:cover; border:1px solid var(--border-soft); }
.product-name { font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.summary { margin-top:30px; padding-top:20px; border-top:1px solid var(--border-soft); }
.summary-row { display:flex; justify-content:space-between; padding:8px 0; }
.summary-total { font-size:20px; font-weight:800; }
.info-row p { margin:0; color:var(--text-muted); font-size:14px; }
.info-value { display:flex; justify-content:flex-end; align-items:center; }
.info-row span { text-align:right; font-weight:500; line-height:1.4; max-height:42px; overflow:hidden; }
@@media (max-width:768px) { .order-table th:nth-child(3), .order-table td:nth-child(3) { display:none; } }
</style>

<section class="breadcrumb breadcrumb_bg">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="breadcrumb_iner">
                    <div class="breadcrumb_iner_item">
                        <h2>Completed</h2>
                        <p>Home <span>-</span> Order Completed</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="order-dark">
    <div class="container">
        <div class="row g-4 mb-5 align-items-stretch">
            <div class="col-lg-6 d-flex">
                <div class="dark-card w-100">
                    <div class="dark-title">🧾 Order Information</div>

                    <div class="info-row">
                        <p>Order ID</p><span>#@Model.Id</span>
                    </div>
                    <div class="info-row">
                        <p>Date</p><span>@Model.OrderDate.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="info-row">
                        <p>Payment</p>
                        <span class="badge-status @paymentBadgeClass">@Model.PaymentStatus</span>
                    </div>
                    <div class="info-row">
                        <p>Method</p><span>@Model.PaymentMethod</span>
                    </div>
                    <div class="info-row">
                        <p>Total</p><span>@total.ToString("C")</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 d-flex">
                <div class="dark-card w-100">
                    <div class="dark-title">📦 Shipping Address</div>

                    <div class="info-row">
                        <p>Name</p><span>@Model.ReceiverName</span>
                    </div>
                    <div class="info-row">
                        <p>Phone</p><span>@Model.ReceiverPhone</span>
                    </div>
                    <div class="info-row">
                        <p>Address</p><span>@Model.ReceiverAddress</span>
                    </div>
                    <div class="info-row">
                        <p>City</p><span>@Model.ReceiverCity</span>
                    </div>
                    <div class="info-row">
                        <p>Country</p><span>@Model.ReceiverCountry</span>
                    </div>
                </div>
            </div>

        </div>


        <div class="dark-card">
            <div class="dark-title">🛒 Order Items</div>

            <div class="table-responsive">
                <table class="order-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Product</th>
                            <th>Size</th>
                            <th>Qty</th>
                            <th>Price</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            var img = !string.IsNullOrEmpty(item.ProductImage)
                            ? (item.ProductImage.StartsWith("http")
                            ? item.ProductImage
                            : $"{CloudinaryConfig.Value.BaseUrl}{item.ProductImage}")
                            : "/images/default.png";

                            <tr>
                                <td><img src="@img" /></td>
                                <td class="product-name">@item.ProductName</td>
                                <td>@item.Size</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("C")</td>
                                <td>@item.Subtotal.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="summary">
                <div class="summary-row">
                    <p>Subtotal</p><span>@subtotal.ToString("C")</span>
                </div>
                <div class="summary-row">
                    <p>Shipping</p><span>@shipping.ToString("C")</span>
                </div>

                @if (Model.DiscountValue > 0)
                {
                    <div class="summary-row text-danger">
                        <p>Discount (@discountPercent.ToString("0.#")%)</p>
                        <span>-@discountAmount.ToString("C")</span>
                    </div>
                }

                <div class="summary-row summary-total">
                    <p>Total</p>
                    <span>@total.ToString("C")</span>
                </div>
            </div>
        </div>
    </div>
</section>