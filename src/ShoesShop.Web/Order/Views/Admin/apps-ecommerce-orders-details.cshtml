@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using ShoesShop.Domain.Orders.Enums
@using ShoesShop.Web.Order.Dtos.Admin.Commands
@model OrderDetailModalDto
@inject Microsoft.Extensions.Options.IOptions<CloudinarySettings> CloudinaryConfig

@{
    ViewData["Title"] = "Order-Details";
    Layout = "~/Shares/Views/Admin/_LayoutAdmin.cshtml";
    var subtotal = Model.OrderDetails.Sum(x => x.Subtotal);
    decimal shipping = Model.ShippingCost ?? 0;
    var discountPercent = (Model.DiscountValue ?? 0) * 100;
    var discountAmount = subtotal * (Model.DiscountValue ?? 0);
    var total = subtotal + shipping - discountAmount;

    int progress = Model.Status switch
    {
        OrderStatus.Pending => 0,
        OrderStatus.Processing => 25,
        OrderStatus.Shipped => 50,
        OrderStatus.Completed => 75,
        OrderStatus.Cancelled => 0,
        _ => 0
    };

}
<style>
    .cancelled-step span {
        color: #dc3545 !important;
        font-weight: 600 !important;
    }

    .h-90 {
        height: 90%;
    }
</style>
<!-- Start Content-->
<div class="container-fluid">

    <!-- start page title -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="javascript: void(0);">Hyper</a></li>
                        <li class="breadcrumb-item"><a href="javascript: void(0);">eCommerce</a></li>
                        <li class="breadcrumb-item active">Order Details</li>
                    </ol>
                </div>
                <h4 class="page-title">Order Details</h4>
            </div>
        </div>
    </div>
    <!-- end page title -->

    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-10 col-sm-11">
            <div class="horizontal-steps mt-4 mb-4 pb-5" id="tooltip-container">
                <div class="horizontal-steps-content">

                    <div class="step-item @(Model.Status == OrderStatus.Pending ? "current" : "")">
                        <span>Order Placed</span>
                    </div>

                    <div class="step-item @(Model.Status == OrderStatus.Processing ? "current" : "")">
                        <span>Processing</span>
                    </div>

                    <div class="step-item @(Model.Status == OrderStatus.Shipped ? "current" : "")">
                        <span>Shipped</span>
                    </div>

                    <div class="step-item @(Model.Status == OrderStatus.Completed ? "current" : "")">
                        <span>Completed</span>
                    </div>

                    <div class="step-item @(Model.Status == OrderStatus.Cancelled ? "current cancelled-step" : "")">
                        <span>Cancelled</span>
                    </div>

                </div>


                @if (Model.Status != OrderStatus.Cancelled)
                {
                    <div class="process-line" style="width:@progress%;"></div>
                }
            </div>
        </div>
    </div>
    <!-- end row -->


    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <h4 class="header-title mb-3">Items from Order #@Model.Id</h4>

                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Item</th>
                                    <th>Name</th>
                                    <th>Quantity</th>
                                    <th>Price</th>
                                    <th>Total</th>

                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderDetails)
                                {
                                    var baseUrl = CloudinaryConfig.Value.BaseUrl.EndsWith("/") ?
                                    CloudinaryConfig.Value.BaseUrl : $"{CloudinaryConfig.Value.BaseUrl}/";
                                    var imgUrl = !string.IsNullOrEmpty(item.ProductImage)
                                    ? (item.ProductImage.StartsWith("http") ? item.ProductImage :
                                    $"{baseUrl}{item.ProductImage}")
                                    : "/images/default.png";

                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <a asp-action="Details" asp-controller="ProductAdmin"
                                                    asp-route-id="@item.ProductId">
                                                    <img src="@imgUrl" alt="Product Image" class="rounded me-2"
                                                        style="width: 50px; height: 50px; object-fit: cover; cursor: pointer;" />
                                                </a>
                                            </div>
                                        </td>

                                        <td>@item.ProductName</td>
                                        <td>@item.Quantity</td>
                                        <td>$@item.UnitPrice</td>
                                        <td>$@item.Subtotal</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- end table-responsive -->

                </div>
            </div>
        </div> <!-- end col -->

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h4 class="header-title mb-3">Order Summary</h4>

                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Description</th>
                                    <th>Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Grand Total :</td>
                                    <td>$@Model.OrderDetails.Sum(od => od.Subtotal)</td>
                                </tr>
                                <tr>
                                    <td>Shipping Charge :</td>
                                    <td>$@Model.ShippingCost</td>
                                </tr>
                                <tr>
                                    <td>Discount : </td>
                                    <td>@($"{Model.DiscountValue * 100:0}%")</td>
                                </tr>
                                <tr>
                                    <th>Total :</th>
                                    <th>$@total.ToString("F2")</th>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <!-- end table-responsive -->

                </div>
            </div>
        </div> <!-- end col -->
    </div>
    <!-- end row -->

    <!-- Export Invoice Beautiful Design -->
    <div class="row mt-4">
        <div class="col-lg-12">
            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <h4 class="header-title mb-1">Invoice</h4>
                        <p class="text-muted mb-0">
                            Download Invoice <b> #@Model.Id </b>
                        </p>
                    </div>

                    <a asp-area="Admin" asp-controller="Orders" asp-action="ExportInvoice" asp-route-id="@Model.Id"
                        class="btn px-4 py-2" style="
                        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
                        color: white;
                        border-radius: 10px;
                        font-weight: 600;
                        box-shadow: 0 4px 10px rgba(40,167,69,0.3);
                        transition: 0.25s;
                   " onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">
                        <i class="mdi mdi-file-pdf-outline me-1"></i>
                        Export Invoice
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Shipping Information -->
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h4 class="header-title mb-3">Receiver Information</h4>

                    <div class="d-flex mb-1">
                        <div class="fw-bold" style="width: 100px;">Name:</div>
                        <div>@Model.ReceiverName</div>
                    </div>
                    <div class="d-flex mb-1">
                        <div class="fw-bold" style="width: 100px;">Address:</div>
                        <div>
                            @Model.ReceiverAddress, @Model.ReceiverCity, @Model.ReceiverCountry
                        </div>
                    </div>
                    <div class="d-flex mb-1">
                        <div class="fw-bold" style="width: 100px;">Phone:</div>
                        <div>@Model.ReceiverPhone</div>
                    </div>
                    <div class="d-flex">
                        <div class="fw-bold" style="width: 100px;">Note:</div>
                        <div>@Model.Note</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Billing Information -->
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h4 class="header-title mb-3">Billing Information</h4>

                    <div class="d-flex mb-1">
                        <div class="fw-bold" style="width: 100px;">Payment:</div>
                        <div>@Model.PaymentMethod</div>
                    </div>
                    <div class="d-flex mb-1">
                        <div class="fw-bold" style="width: 100px;">Status:</div>
                        <div>@Model.PaymentStatus</div>
                    </div>
                    <div class="d-flex mb-1">
                        <div class="fw-bold" style="width: 100px;">Date:</div>
                        <div>@Model.OrderDate</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Delivery Info -->
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h4 class="header-title mb-3">Delivery Info</h4>
                    <div class="text-center">
                        <i class="mdi mdi-truck-fast h2 text-muted"></i>
                    </div>
                    <h5 class="text-center"><b>UPS Delivery</b></h5>
                    <p class="mb-0 text-center"><b>Order ID :</b> @Model.Id</p>
                </div>
            </div>
        </div>
    </div>


    <!-- end row -->
</div> <!-- container -->