@using ShoesShop.Web.Modules.Users.Order.Dtos.Commands
@model ChatModalDto
@inject Microsoft.Extensions.Options.IOptions<CloudinarySettings> CloudinaryConfig

@{
    var baseUrl = CloudinaryConfig.Value.BaseUrl.TrimEnd('/') + "/";
    var adminDefaultAvatar = Url.Content("~/assets/images/admin-default.jpg");
    var userDefaultAvatar = Url.Content("~/assets/images/user-default.png");
    var currentUserId = User.FindFirst("userId")?.Value ?? "0";
}

<style>
.chat-messages { max-height: 70vh; overflow-y: auto; padding: 20px; background: #111214; border: 1px solid #222; border-radius: 14px; }
.chat-messages::-webkit-scrollbar { width: 6px; }
.chat-messages::-webkit-scrollbar-thumb { background: #444; border-radius: 10px; }
.chat-message { margin-bottom: 18px; animation: fadeUp 0.25s ease-out; }
.chat-message-header { font-size: 12px; color: #888; margin-bottom: 5px; }
.message-row { display: flex; align-items: flex-end; gap: 10px; }
.message-row img.avatar { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; border: 1px solid #333; }
.bubble { max-width: 60%; padding: 12px 16px; border-radius: 18px; font-size: 15px; line-height: 1.4; word-break: break-word; }
.chat-message.user .message-row { flex-direction: row-reverse; }
.chat-message.user .bubble { background: #0078ff; color: #fff; border-top-right-radius: 4px; box-shadow: 0 0 6px rgba(0,120,255,0.4); }
.chat-message.shop .message-row { flex-direction: row-reverse; }
.chat-message.shop .bubble { background: #1f1f1f; color: #ddd; border-top-left-radius: 4px; border: 1px solid #2c2c2c; }
.chat-message small { display: block; margin-top: 4px; font-size: 11px; color: #666; }
.chat-input { margin-top: 15px; display: flex; gap: 10px; background: #151515; padding: 12px; border-radius: 12px; border: 1px solid #222; }
.chat-input textarea { flex: 1; height: 55px; padding: 12px; resize: none; border-radius: 12px; background: #1e1e1e; border: 1px solid #333; color: #eee; font-size: 14px; }
.chat-input button { width: 120px; border: none; background: #0078ff; color: white; border-radius: 12px; cursor: pointer; font-weight: 600; transition: 0.2s; }
.chat-input button:hover { background: #0066d6; }
keyframes fadeUp { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
</style>


<input type="hidden" id="orderId" value="@Model.OrderId" />
<input type="hidden" id="receiverId" value="0" />

<div id="chatMessages" class="chat-messages">
    @foreach (var msg in Model.Message.OrderBy(m => m.SentAt))
    {
        bool isAdmin = msg.SenderRole?.StartsWith("Admin") == true;
        string cssClass = isAdmin ? "shop" : "user";

        string avatarUrl = isAdmin
            ? Url.Content("~/assets/images/admin-default.jpg")
            : (!string.IsNullOrWhiteSpace(msg.SenderAvatar)
                ? (msg.SenderAvatar.StartsWith("http") ? msg.SenderAvatar : $"{baseUrl}{msg.SenderAvatar}")
                : Url.Content("~/assets/images/user-default.png"));
        
        string senderName = isAdmin ? "Admin" : msg.SenderName ?? "User";

        var vnTime = TimeZoneInfo.ConvertTimeFromUtc(
            msg.SentAt,
            TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time")
        );

        <div class="chat-message @cssClass">
            <span class="chat-message-header">@senderName</span>

            <div class="message-row">
                @if (!isAdmin)
                {
                    <img src="@avatarUrl" class="avatar" />
                }

                <div class="bubble">@msg.Content</div>

                @if (isAdmin)
                {
                    <img src="@avatarUrl" class="avatar" />
                }
            </div>

            <small>@vnTime.ToString("HH:mm dd/MM/yyyy")</small>
        </div>
    }
</div>

<form id="chatForm" class="chat-input">
    <textarea name="Content" placeholder="Type a message..." required></textarea>
    <button type="submit">Send</button>
</form>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
const orderId = parseInt(document.getElementById("orderId").value);
const senderId = parseInt('@currentUserId');
const chatMessages = document.getElementById("chatMessages");
const chatForm = document.getElementById("chatForm");
const chatTextarea = chatForm.querySelector('textarea[name="Content"]');
const senderName = '@(User.Identity?.Name ?? "Bạn")';
const baseUrl = '@baseUrl';

const userAvatar = "@Html.Raw(
    !string.IsNullOrEmpty(Model.CurrentUserAvatar)
        ? (Model.CurrentUserAvatar.StartsWith("http")
            ? Model.CurrentUserAvatar
            : baseUrl + Model.CurrentUserAvatar)
        : Url.Content("~/assets/images/user-default.png")
)";


chatTextarea.addEventListener("keydown", async e => {
    if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        chatForm.dispatchEvent(new Event("submit", { cancelable: true, bubbles: true }));
    }
});

function generateTempId() {
    return Math.random().toString(36).substring(2, 9);
}

function getAvatarUrl(msg){
    if (msg.senderRole === "Admin") {
        return '@Url.Content("~/assets/images/admin-default.jpg")';
    }

    if (msg.senderAvatar){
        return msg.senderAvatar.startsWith("http") ? msg.senderAvatar : `${baseUrl}${msg.senderAvatar}`;
    }

    return '@Url.Content("~/assets/images/user-default.png")';
}

function appendMessage(msg){
    const isAdmin = msg.senderRole === "Admin";
    const avatarUrl = getAvatarUrl(msg);
    const senderName = isAdmin ? "Admin" : msg.senderName || "User";

    const sentDate = msg.sentAt ? new Date(msg.sentAt) : new Date();
    const sentAt = sentDate.toLocaleString("vi-VN", {
        hour: "2-digit", minute: "2-digit",
        day: "2-digit", month: "2-digit", year: "numeric"
    });

    const div = document.createElement("div");
    div.className = `chat-message ${isAdmin ? "shop" : "user"}`;
    if (msg.TempId) div.dataset.tempId = msg.TempId;

    div.innerHTML = `
        <span class="chat-message-header">${senderName}</span>
        <div class="message-row">
            ${!isAdmin ? `<img src="${avatarUrl}" class="avatar" />` : ""}
            <div class="bubble">${msg.content}</div>
            ${isAdmin ? `<img src="${avatarUrl}" class="avatar" />` : ""}
        </div>
        <small>${sentAt}</small>
    `;

    chatMessages.appendChild(div);
    chatMessages.scrollTop = chatMessages.scrollHeight;
}

if (!window.chatHubConnection) {
    window.chatHubConnection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .withAutomaticReconnect()
        .build();
}

const connection = window.chatHubConnection;
let connectionStarted = false;

async function safeConnect() {
    if (connectionStarted) return;
    if (connection.state !== "Disconnected") return;

    try {
        await connection.start();
        await connection.invoke("JoinOrderGroup", orderId);
        connectionStarted = true;
        console.log("Connected safely");
    } catch (e) {
        console.error("Connect failed:", e);
    }
}

connection.on("ReceiveMessage", msg => {

    const msgOrderId = parseInt(msg.orderId || msg.OrderId || 0);
    if (msgOrderId !== orderId) return;

    // Replace temp bubble
    if (msg.senderId === senderId && msg.tempId) {
        const tempEl = document.querySelector(`[data-temp-id='${msg.tempId}']`);
        if (tempEl) tempEl.remove();
    }

    appendMessage(msg);
});

/* ==========================
   AUTO CONNECT ONLY WHEN NEEDED
========================== */
document.addEventListener("DOMContentLoaded", safeConnect);

document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") {
        safeConnect();
    }
});

window.addEventListener("beforeunload", () => {
    if (connection && connection.state === "Connected") {
        connection.stop();
    }
});

chatForm.addEventListener("submit", async e => {
    e.preventDefault();

    if (!connectionStarted) return alert("Đang kết nối...");

    const content = chatTextarea.value.trim();
    if (!content) return;

    const tempId = generateTempId();

    appendMessage({
        orderId,
        senderRole: "User",
        senderName,
        senderAvatar: userAvatar,
        content,
        sentAt: new Date(),
        senderId,
        TempId: tempId
    });

    await connection.invoke("SendMessage", -1, content, orderId, tempId);

    chatTextarea.value = "";
});
</script>