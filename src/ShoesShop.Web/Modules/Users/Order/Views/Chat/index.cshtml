@using ShoesShop.Domain.Modules.User.Orders.Dtos.Commands
@using ShoesShop.Web.Modules.Users.Order.Dtos.Commands
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model ChatModalDto

@{
    ViewData["Title"] = "Chat";
    Layout = "~/Modules/Users/Shares/Views/_Layout.cshtml";
}

<style>
.chat-container { display: flex; gap: 20px; height: 75vh; margin-top: 25px; }
.chat-users { width: 26%; background: #1b1b1b; border-radius: 12px; overflow-y: auto; border: 1px solid #333; }
.chat-users h5 { padding: 15px; font-weight: 600; color: #fff; border-bottom: 1px solid #333; }
.chat-user-item { padding: 14px 18px; color: #ccc; cursor: pointer; border-bottom: 1px solid #2a2a2a; transition: 0.2s ease; }
.chat-user-item:hover { background: #2a2a2a; }
.chat-user-item.active { background: #0071e3; border-left: 4px solid #fff; }
.chat-area { flex: 1; background: #1b1b1b; border-radius: 12px; display: flex; flex-direction: column; border: 1px solid #333; }
.chat-header { padding: 15px; font-weight: 600; color: #fff; border-bottom: 1px solid #333; }
.chat-messages { flex: 1; padding: 20px; overflow-y: auto; background: #1b1b1b; display: flex; flex-direction: column; gap: 12px; }
.chat-message { display: flex; flex-direction: column; max-width: 75%; }
.chat-message.user { align-self: flex-end; text-align: right; }
.chat-message.shop { align-self: flex-start; text-align: left; }
.chat-message .bubble { padding: 12px 16px; border-radius: 18px; font-size: 14px; line-height: 1.4; word-wrap: break-word; }
.chat-message.user .bubble { background-color: #0071e3; color: #fff; border-bottom-right-radius: 5px; }
.chat-message.shop .bubble { background-color: #2a2a2a; color: #ddd; border-bottom-left-radius: 5px; }
.chat-message-header { font-size: 12px; font-weight: 600; color: #aaa; margin-bottom: 4px; }
.chat-message small { font-size: 11px; color: #777; margin-top: 2px; }
.message-row { display: flex; align-items: flex-end; gap: 8px; }
.chat-message img { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
.chat-input { padding: 12px; border-top: 1px solid #333; display: flex; gap: 12px; background: #1b1b1b; }
.chat-input textarea { flex: 1; resize: none; padding: 12px; border-radius: 14px; background: #2a2a2a; color: #fff; border: 1px solid #444; }
.chat-input button { padding: 0 22px; border-radius: 14px; background: #0071e3; color: #fff; font-weight: 600; border: none; transition: 0.15s; }
.chat-input button:hover { background: #0058a8; }
</style>

<div class="container-fluid" style="margin-top:200px;">
    <div class="row mb-3">
        <div class="col-12">
            <h4 class="page-title" style="color:white;">Chat with Shop - Order #@Model.OrderId</h4>
        </div>
    </div>

    <div class="chat-container">
        <!-- ORDERS LIST -->
        <div class="chat-users">
            <h5>Your Orders</h5>
            <div class="chat-user-item active">
                Order #@Model.OrderId
            </div>
        </div>

        <!-- CHAT AREA -->
        <div class="chat-area">
            <div class="chat-header">
                Chat about Order #@Model.OrderId
            </div>
            @await Html.PartialAsync(partialViewName: "~/Modules/Users/Order/Views/Chat/Chat-area.cshtml", Model)
        </div>
    </div>
</div>

<script>
    let box = document.getElementById("chatMessages");
    if (box) box.scrollTop = box.scrollHeight;
</script>