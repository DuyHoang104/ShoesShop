@using Microsoft.Extensions.Options
@using ShoesShop.Domain.Modules.User.Shares.Dtos

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model ShoesShop.Web.Modules.Admins.Products.Dtos.ProductAdminDto
@{
ViewData["Title"] = "Products";
Layout = "~/Modules/Admins/Shares/Views/_LayoutAdmin.cshtml";
}
@inject IOptions<CloudinarySettings> CloudinaryConfig
<style>
/* Base style for sizes */
.size-option {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    position: relative;
    padding: 8px 14px;
    border-radius: 50%;
    border: 2px solid #007bff;
    background-color: #f8f9ff;
    color: #007bff;
    font-weight: 500;
    cursor: pointer;
    user-select: none;
    width: 45px;
    height: 45px;
    font-size: 14px;
    transition: all 0.3s ease;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}

/* Hover effect */
.size-option:hover:not(.disabled) {
    background-color: #007bff;
    color: white;
    transform: scale(1.1);
}

/* Selected style */
.size-option.selected {
    background-color: #007bff;
    color: white;
    box-shadow: 0 0 10px rgba(0,123,255,0.6);
    transform: scale(1.1);
}

/* Disabled style */
.size-option.disabled {
    background-color: #e0e0e0;
    color: #007bff;
    cursor: not-allowed;
}

/* Cross for unavailable sizes */
.size-option.disabled .cross {
    position: absolute;
    font-size: 12px;
    color: red;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const sizeOptions = document.querySelectorAll('.size-option');

    sizeOptions.forEach(option => {
        if (!option.classList.contains('disabled')) {
            option.addEventListener('click', () => {
                option.classList.toggle('selected');
            });
        }
    });
});
</script>
<!-- Start Content-->
<div class="container-fluid">

<!-- start page title -->
<div class="row">
    <div class="col-12">
        <div class="page-title-box">
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Hyper</a></li>
                    <li class="breadcrumb-item"><a href="javascript: void(0);">eCommerce</a></li>
                    <li class="breadcrumb-item active">Product Details</li>
                </ol>
            </div>
            <h4 class="page-title">Product Details</h4>
        </div>
    </div>
</div>     
<!-- end page title --> 

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-5">
                        <!-- Product image -->
                        @if (Model.Images != null && Model.Images.Any())
                        {
                            <!-- Main Image: hiển thị ảnh đầu tiên -->
                            <a href="javascript:void(0);" class="text-center d-block mb-4">
                                <img src="@Model.Images.First().Url.ToCloudinaryUrl(CloudinaryConfig.Value.BaseUrl)" 
                                    class="img-fluid" style="max-width: 280px;" alt="Product-img">
                            </a>

                            <!-- Thumbnails -->
                            <div class="d-lg-flex d-none justify-content-center flex-wrap gap-2">
                                @for (int i = 0; i < Model.Images.Count; i++)
                                {
                                    <a href="javascript:void(0);">
                                        <img src="@Model.Images[i].Url.ToCloudinaryUrl(CloudinaryConfig.Value.BaseUrl)" 
                                            class="img-fluid img-thumbnail p-2" style="max-width: 75px;" alt="Product-img">
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <p>No images available.</p>
                        }

                    </div> <!-- end col -->
                    <div class="col-lg-7">
                        <form class="ps-lg-4">
                            <!-- Product title -->
                            <h3 class="mt-0">@Model.Name <a href="javascript: void(0);" class="text-muted"><i class="mdi mdi-square-edit-outline ms-2"></i></a> </h3>
                            <p class="mb-1">Added Date: 2025</p>
                            <p class="font-16">
                                <span class="text-warning mdi mdi-star"></span>
                                <span class="text-warning mdi mdi-star"></span>
                                <span class="text-warning mdi mdi-star"></span>
                                <span class="text-warning mdi mdi-star"></span>
                                <span class="text-warning mdi mdi-star"></span>
                            </p>

                            <!-- Product stock -->
                            <div class="mt-3">
                                <h4><span class="badge badge-success-lighten">@Model.Status</span></h4>
                            </div>

                            <!-- Product description -->
                            <div class="mt-4">
                                <h6 class="font-14">Retail Price:</h6>
                                <h3> $@Model.Price</h3>
                            </div>
                
                            <!-- Product description -->
                            <div class="mt-4">
                                <h6 class="font-14">Description:</h6>
                                <p>@Model.Description</p>
                            </div>

                            <div class="mt-4">
                                <h6 class="font-14 mb-2">Available Size:</h6>
                                <div class="d-flex flex-wrap gap-2">
                                    @{
                                        var allSizes = Enumerable.Range(36, 12).ToList(); // 36 đến 47
                                        var availableSizes = string.IsNullOrWhiteSpace(Model.Sizes)
                                            ? new List<string>()
                                            : Model.Sizes.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                                        .Select(s => s.Trim())
                                                        .ToList();
                                    }

                                    @foreach (var size in allSizes)
                                    {
                                        if (availableSizes.Contains(size.ToString()))
                                        {
                                            <span class="size-option" data-size="@size">@size</span>
                                        }
                                        else
                                        {
                                            <span class="size-option disabled" data-size="@size">
                                                @size
                                                <span class="cross">✖</span>
                                            </span>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Product information -->
                            <div class="mt-4">
                                <div class="row">
                                    <div class="col-md-4">
                                        <h6 class="font-14">Available Stock:</h6>
                                        <p class="text-sm lh-150">@Model.Quantity</p>
                                    </div>
                                    <div class="col-md-4">
                                        <h6 class="font-14">Quantity:</h6>
                                        <p class="text-sm lh-150">@Model.Quantity</p>
                                    </div>
                                    <div class="col-md-4">
                                        <h6 class="font-14">Categories:</h6>
                                        <p class="text-sm lh-150">
                                            @foreach (var c in Model.Categories)
                                            {
                                                @c.Name <br />
                                            }
                                        </p>
                                    </div>
                                </div>
                            </div>

                        </form>
                    </div> <!-- end col -->
                </div> <!-- end row-->

                <div class="table-responsive mt-4">
                    <table class="table table-bordered table-centered mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Outlets</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>ASOS Ridley Outlet - NYC</td>
                                <td>$139.58</td>
                                <td>
                                    <div class="progress-w-percent mb-0">
                                        <span class="progress-value">478 </span>
                                        <div class="progress progress-sm">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: 56%;" aria-valuenow="56" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                </td>
                                <td>$1,89,547</td>
                            </tr>
                            <tr>
                                <td>Marco Outlet - SRT</td>
                                <td>$149.99</td>
                                <td>
                                    <div class="progress-w-percent mb-0">
                                        <span class="progress-value">73 </span>
                                        <div class="progress progress-sm">
                                            <div class="progress-bar bg-danger" role="progressbar" style="width: 16%;" aria-valuenow="16" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                </td>
                                <td>$87,245</td>
                            </tr>
                            <tr>
                                <td>Chairtest Outlet - HY</td>
                                <td>$135.87</td>
                                <td>
                                    <div class="progress-w-percent mb-0">
                                        <span class="progress-value">781 </span>
                                        <div class="progress progress-sm">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: 72%;" aria-valuenow="72" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                </td>
                                <td>$5,87,478</td>
                            </tr>
                            <tr>
                                <td>Nworld Group - India</td>
                                <td>$159.89</td>
                                <td>
                                    <div class="progress-w-percent mb-0">
                                        <span class="progress-value">815 </span>
                                        <div class="progress progress-sm">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: 89%;" aria-valuenow="89" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                </td>
                                <td>$55,781</td>
                            </tr>
                        </tbody>
                    </table>
                </div> <!-- end table-responsive-->
                
            </div> <!-- end card-body-->
        </div> <!-- end card-->
    </div> <!-- end col-->
</div>
<!-- end row-->

</div> <!-- container -->

