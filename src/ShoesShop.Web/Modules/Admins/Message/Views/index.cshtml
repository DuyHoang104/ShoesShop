@using ShoesShop.Domain.Modules.Shares.Messages.Dtos
@using ShoesShop.Domain.Modules.User.Users.Dtos
@using ShoesShop.Web.Modules.Admins.Message.Dtos
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject Microsoft.Extensions.Options.IOptions<CloudinarySettings> CloudinaryConfig
@model List<OrderChatDto>

@{
    ViewData["Title"] = "Chat";
    Layout = "~/Modules/Admins/Shares/Views/_LayoutAdmin.cshtml";
    UserDto u = null;
    if (ViewBag.SelectedOrderId != null)
    {
        u = Model.FirstOrDefault(x => x.Order.Id == (int)ViewBag.SelectedOrderId)?.User;
    }

    var baseUrl = CloudinaryConfig.Value.BaseUrl.EndsWith("/") ? CloudinaryConfig.Value.BaseUrl : $"{CloudinaryConfig.Value.BaseUrl}/";
    var imgUrl = !string.IsNullOrEmpty(u?.AvatarUrl)
        ? (u.AvatarUrl.StartsWith("http") ? u.AvatarUrl : $"{baseUrl}{u.AvatarUrl}")
        : Url.Content("~/assets/images/user-default.png");

    
    var selectedChat = Model.FirstOrDefault(x => 
    (x.Order != null && x.Order.Id == (int?)ViewBag.SelectedOrderId) || 
    (x.Order == null && x.User.ID == (int?)ViewBag.UserId));
    u = selectedChat?.User;
}

<!-- Start Content-->
<div class="container-fluid">
    <!-- start page title -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="javascript: void(0);">Hyper</a></li>
                        <li class="breadcrumb-item"><a href="javascript: void(0);">Apps</a></li>
                        <li class="breadcrumb-item active">Chat</li>
                    </ol>
                </div>
                <h4 class="page-title">Chat</h4>
            </div>
        </div>
    </div>
    <!-- end page title -->

    <div class="row">
        <!-- start chat users-->
        <div class="col-xxl-3 col-xl-6 order-xl-1 d-flex">
            <div class="card flex-fill">
                <div class="card-body p-0">
                    <ul class="nav nav-tabs nav-bordered">
                        <li class="nav-item">
                            <a href="#allUsers" data-bs-toggle="tab" aria-expanded="false" class="nav-link active py-2">
                                All
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#favUsers" data-bs-toggle="tab" aria-expanded="true" class="nav-link py-2">
                                Favourites
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#friendUsers" data-bs-toggle="tab" aria-expanded="true" class="nav-link py-2">
                                Others
                            </a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane show active p-3" id="newpost">

                            <!-- start search box -->
                            <div class="app-search">
                                <form>
                                    <div class="mb-2 position-relative">
                                        <input type="text" class="form-control" placeholder="People, groups & messages...">
                                        <span class="mdi mdi-magnify search-icon"></span>
                                    </div>
                                </form>
                            </div>
                            <!-- end search box -->

                            <!-- users -->
                            <div class="row">
                                <div class="col">
                                    <div data-simplebar="" style="max-height: 550px;">
                                        @foreach (var item in Model.OrderByDescending(x => x.LastMessage?.SentAt))
                                        {
                                            var chatUser = item.User;
                                            var lastMessage = item.LastMessage;

                                            string displayTitle = item.Order != null ? $"Order #{item.Order.Id}" : chatUser?.UserName ?? "User";

                                            <a  href="javascript:void(0);" 
                                                onclick="postChat(@item.Order?.Id)"
                                                style="all: unset; cursor:pointer; width:100%; display:block;">
                                                    <div class="d-flex align-items-start bg-light p-2">
                                                        <div class="w-100 overflow-hidden">
                                                            <h5 class="mt-0 mb-0 font-14">
                                                                <span class="float-end text-muted font-12">
                                                                    @(lastMessage != null ? lastMessage.SentAt.ToString("HH:mm") : "")
                                                                </span>
                                                                @displayTitle
                                                            </h5>

                                                            <p class="mt-1 mb-0 text-muted font-14">
                                                                User : @(chatUser?.UserName ?? "User")
                                                            </p>

                                                            <p class="mt-1 mb-0 text-muted font-14">
                                                                Message : @(lastMessage != null ? lastMessage.Content : "No messages yet.")
                                                            </p>
                                                        </div>
                                                    </div>
                                                </a>
                                        }
                                    </div>
                                </div>
                            </div>
                            <!-- end users -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- end chat users-->

        <!-- chat area -->
        @await Html.PartialAsync(
            "~/Modules/Admins/Message/Views/Chat-area.cshtml",
            ViewData["Messages"] as List<MessageDto>
        )
        <!-- end chat area-->

        <!-- start user detail -->
        <div class="col-xxl-3 col-xl-6 order-xl-1 order-xxl-2 d-flex">
            <div class="card flex-fill">
                <div class="card-body">
                    <div class="dropdown float-end">
                        <a href="#" class="dropdown-toggle arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="mdi mdi-dots-horizontal"></i>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end">
                            <a href="javascript:void(0);" class="dropdown-item">View full</a>
                            <a href="javascript:void(0);" class="dropdown-item">Edit Contact Info</a>
                            <a href="javascript:void(0);" class="dropdown-item">Remove</a>
                        </div>
                    </div>

                    <div class="mt-3 text-center">
                        
                        <img src="@imgUrl" alt="User" class="img-thumbnail avatar-lg rounded-circle">
                        <h4>@(u?.UserName ?? "Unknown")</h4>
                        <button class="btn btn-primary btn-sm mt-1" ><i class='uil uil-envelope-add me-1'></i>
                        <a href="@Url.Action("Details", "UserAdmin", new { id = u?.ID ?? 0 })" style="color: #fff;">See Profile</a></button>
                        <p class="text-muted mt-2 font-14">Last Interacted: <strong>No interactions yet</strong></p>
                    </div>

                    <div class="mt-3">
                        <hr />

                        <p class="mt-4 mb-1"><strong><i class='uil uil-at'></i> Email:</strong></p>
                        <p>@(u?.Email ?? "Unknown")</p>

                        <p class="mt-3 mb-1"><strong><i class='uil uil-phone'></i> Phone Number:</strong></p>
                        <p>@(u?.Phone ?? "Unknown")</p>

                        <p class="mt-3 mb-1"><strong><i class='uil uil-location'></i> Location:</strong></p>
                        @if(u?.Addresses != null)
                        {
                            foreach(var addr in u.Addresses)
                            {
                                <p>@addr.AddressLine1 - Default: @addr.IsDefault</p>
                            }
                        }
                        else
                        {
                            <p>Unknown</p>
                        }
                    </div>
                </div>
            </div>
        </div>
        <!-- end user detail -->
    </div>
</div>
<script>
function postChat(orderId) {
    // tạo form ẩn
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/Admin/Messages/Chat';

    // input orderId
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'orderId';
    input.value = orderId;
    form.appendChild(input);

    // anti-forgery token (MVC)
    const token = document.querySelector("input[name='__RequestVerificationToken']");
    if (token) {
        const tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = '__RequestVerificationToken';
        tokenInput.value = token.value;
        form.appendChild(tokenInput);
    }

    document.body.appendChild(form);
    form.submit();
}
</script>
