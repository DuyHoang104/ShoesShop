@using ShoesShop.Domain.Modules.User.Orders.Enums
@using ShoesShop.Domain.Modules.User.Users.Enums
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model ShoesShop.Web.Modules.Admins.Orders.Dtos.GetAllInfoUsersAdminDto
@inject Microsoft.Extensions.Options.IOptions<CloudinarySettings> CloudinaryConfig

@{
    ViewData["Title"] = "User Profile";
    Layout = "~/Modules/Admins/Shares/Views/_LayoutAdmin.cshtml";

    var baseUrl = CloudinaryConfig.Value.BaseUrl.EndsWith("/") ? CloudinaryConfig.Value.BaseUrl : $"{CloudinaryConfig.Value.BaseUrl}/";
    var imgUrl = !string.IsNullOrEmpty(Model.AvatarUrl) 
        ? (Model.AvatarUrl.StartsWith("http") ? Model.AvatarUrl : $"{baseUrl}{Model.AvatarUrl}") 
        : "/images/default.png";
}

<div class="container-fluid">

    <!-- Page Title -->
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="page-title">User Profile</h4>
        </div>
    </div>

    <!-- Row 1: Profile Card + Personal Info -->
    <div class="row d-flex align-items-stretch mb-4">
        <!-- Profile Card -->
        <div class="col-lg-4 mb-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <img src="@imgUrl" class="rounded-circle mb-3" style="width:120px; height:120px; object-fit:cover;">
                    <h4 class="mb-1">@Model.UserName</h4>
                    <p class="mb-1">@Model.Email</p>
                    <p>@Model.Phone</p>
                    <span class="badge bg-primary">@Model.Role</span>
                    <span class="badge @(Model.Status == UserStatus.Active ? "bg-success" : "bg-danger")">
                        @Model.Status
                    </span>
                </div>
            </div>
        </div>

        <!-- Personal Info -->
        <div class="col-lg-8 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Personal Info</h5>

                    <div class="d-flex mb-2">
                        <div class="fw-bold" style="width: 150px;">UserName:</div>
                        <div>@Model.UserName</div>
                    </div>

                    <div class="d-flex mb-2">
                        <div class="fw-bold" style="width: 150px;">Email:</div>
                        <div>@Model.Email</div>
                    </div>

                    <div class="d-flex mb-2">
                        <div class="fw-bold" style="width: 150px;">Phone:</div>
                        <div>@Model.Phone</div>
                    </div>

                    <div class="d-flex mb-2">
                        <div class="fw-bold" style="width: 150px;">Date of Birth:</div>
                        <div>@Model.DateOfBirth.ToString("MM/dd/yyyy")</div>
                    </div>

                    <div class="d-flex mb-2">
                        <div class="fw-bold" style="width: 150px;">Gender:</div>
                        <div>@Model.Gender.ToString()</div>
                    </div>

                    <div class="d-flex mb-2 align-items-center">
                        <div class="fw-bold" style="width: 150px;">Role:</div>
                        <div class="d-inline-flex align-items-center">
                            <span id="current-role">@Model.Role.ToString()</span>
                            <a href="javascript:void(0);" class="action-icon edit-role-btn ms-2" data-user-id="@Model.ID">
                                <i class="mdi mdi-square-edit-outline" style="font-size: 1.5rem;"></i>
                            </a>
                        </div>
                    </div>

                    <div class="d-flex mb-2">
                        <div class="fw-bold" style="width: 150px;">Status:</div>
                        <div>@Model.Status.ToString()</div>
                    </div>

                </div>
            </div>
        </div>

     </div>

    <!-- Row 2: Addresses -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Addresses</h5>
                    @foreach(var addr in Model.Addresses)
                    {
                        <div class="position-relative border rounded p-2 mb-2">
                            <p>@addr.AddressLine1<br />@addr.City, @addr.Country</p>
                            @if(addr.IsDefault)
                            {
                                <span class="badge bg-success position-absolute top-0 end-0 m-2">Default</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Row 3: Order History -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Order History</h5>
                    <div class="table-responsive">
                        <table class="table table-centered table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Order ID</th>
                                    <th>Order Date</th>
                                    <th>Status</th>
                                    <th>Total</th>
                                    <th>Payment</th>
                                    <th>Payment Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if( Model.Orders == null || !Model.Orders.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center">No orders found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach(var o in Model.Orders)
                                    {
                                        var statusClass = o.Status switch
                                        {
                                            OrderStatus.Completed => "bg-success",
                                            OrderStatus.Processing => "bg-primary",
                                            OrderStatus.Shipped => "bg-warning text-dark",
                                            _ => "bg-secondary"
                                        };

                                        var orderSubtotal = o.SubTotal;
                                        var orderShipping = o.ShippingFee ?? 0;
                                        var orderDiscount = (o.Discount ?? 0) * o.SubTotal;
                                        var orderTotal = orderSubtotal + orderShipping - orderDiscount;

                                        <tr>
                                            <td>
                                                <a asp-action="Details" asp-controller="OrderAdmin" asp-route-id="@o.Id">
                                                    #@o.Id
                                                </a>
                                            </td>
                                            <td>@o.OrderDate.ToString("MM/dd/yyyy")</td>
                                            <td>
                                                <span class="badge @statusClass">@o.Status</span>
                                            </td>
                                            <td>$@orderTotal.ToString("F2")</td>
                                            <td>@o.PaymentMethod</td>
                                            <td>@o.PaymentStatus</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
$(document).ready(function () {
    $('.edit-role-btn').on('click', function () {
        var userId = $(this).data('user-id');

        Swal.fire({
            title: 'Change Role?',
            text: "Toggle user's role between Admin and Customer.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes',
            cancelButtonText: 'Cancel',
            width: '350px',
            padding: '1rem',
            buttonsStyling: true,
            customClass: {
                popup: 'small-swal-popup',
                title: 'small-swal-title',
                content: 'small-swal-content',
                confirmButton: 'small-swal-btn',
                cancelButton: 'small-swal-btn'
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Admin/Users/UpdateRole/' + userId,
                    type: 'GET',
                    success: function (res) {
                        var currentRole = $('#current-role');
                        if(res.success) {
                            currentRole.text(currentRole.text() === 'Admin' ? 'Customer' : 'Admin');

                            Swal.fire({
                                title: 'Updated!',
                                text: res.message,
                                icon: 'success',
                                width: '350px',
                                padding: '1rem',
                                customClass: {
                                    popup: 'small-swal-popup',
                                    title: 'small-swal-title',
                                    content: 'small-swal-content',
                                    confirmButton: 'small-swal-btn'
                                }
                            });
                        } else {
                            Swal.fire({
                                title: 'Error!',
                                text: res.message,
                                icon: 'error',
                                width: '350px',
                                padding: '1rem',
                                customClass: {
                                    popup: 'small-swal-popup',
                                    title: 'small-swal-title',
                                    content: 'small-swal-content',
                                    confirmButton: 'small-swal-btn'
                                }
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            title: 'Error!',
                            text: 'Failed to update role.',
                            icon: 'error',
                            width: '350px',
                            padding: '1rem',
                            customClass: {
                                popup: 'small-swal-popup',
                                title: 'small-swal-title',
                                content: 'small-swal-content',
                                confirmButton: 'small-swal-btn'
                            }
                        });
                    }
                });
            }
        });
    });
});
</script>

<style>
.small-swal-popup { font-size: 0.9rem; }
.small-swal-title { font-size: 1rem; }
.small-swal-content { font-size: 0.85rem; }
.small-swal-btn { font-size: 0.85rem; padding: 0.35rem 0.75rem; }
</style>
}

