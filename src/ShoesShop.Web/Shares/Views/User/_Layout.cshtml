@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Security.Claims
@using ShoesShop.Domain.Users.Dtos
@using ShoesShop.Domain.Users.Services
@inject IUserService _userService

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject Microsoft.Extensions.Options.IOptions<CloudinarySettings> CloudinaryConfig

@{
  var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
  var userId = User.FindFirst("userId")?.Value;
  UserDto? currentUser = null;
  if (User.Identity != null && User.Identity.IsAuthenticated)
  {
    var userIdClaim = User.FindFirst("userId")?.Value;
    if (!string.IsNullOrEmpty(userIdClaim) && int.TryParse(userIdClaim, out var userIdInt))
    {
      currentUser = await _userService.GetUserByIdAsync(userIdInt);
    }
  }
  string avatarUrl = "~/assets/images/default-avatar.png";
  if (currentUser != null && !string.IsNullOrEmpty(currentUser.AvatarUrl))
  {
    avatarUrl = currentUser.AvatarUrl.StartsWith("http")
    ? currentUser.AvatarUrl
    : $"{CloudinaryConfig.Value.BaseUrl}{currentUser.AvatarUrl}";
  }
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Arrisd - Amazing & Incredible Shoes</title>
  <meta name="title" content="Arrisd - Amazing & Incredible Shoes">
  <meta name="description" content="This is a Shoes html template made by codewithsadee">
  <link rel="shortcut icon" href="~/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@latest/css/boxicons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;700&family=Forum&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/assets/css/styles.css">
  <link rel="preload" as="image" href="~/assets/images/hero-slider-1.jpg">
  <link rel="preload" as="image" href="~/assets/images/hero-slider-2.jpg">
  <link rel="preload" as="image" href="~/assets/images/hero-slider-3.jpg">

</head>

<body id="top">

  <div class="preload" data-preaload>
    <div class="circle"></div>
    <p class="text">Arrisd</p>
  </div>

  <div class="topbar">
    <div class="cw-container">

      <address class="topbar-item">
        <div class="cw-icon">
          <ion-icon name="location-outline" aria-hidden="true"></ion-icon>
        </div>

        <span class="span">
          Ngo Quyen St, Da Nang City, Vietnam
        </span>
      </address>

      <div class="separator"></div>

      <div class="topbar-item item-2">
        <div class="cw-icon">
          <ion-icon name="time-outline" aria-hidden="true"></ion-icon>
        </div>

        <span class="span">Daily : 8.00 am to 10.00 pm</span>
      </div>

      <a href="tel:+11234567890" class="topbar-item link">
        <div class="cw-icon">
          <ion-icon name="call-outline" aria-hidden="true"></ion-icon>
        </div>

        <span class="span">+1 123 456 7890</span>
      </a>

      <div class="separator"></div>

      <a href="mailto:Order@arrisd.com" class="topbar-item link">
        <div class="cw-icon">
          <ion-icon name="mail-outline" aria-hidden="true"></ion-icon>
        </div>

        <span class="span">Order@arrisd.com</span>
      </a>

    </div>
  </div>

  <header class="cw-header" data-header>
    <div class="cw-container">
      <a class="logo" asp-action="Index" asp-controller="Home">
        <img src="~/assets/images/logo.png" width="100" height="50" alt="Arrisd - Home">
      </a>

      <nav class="cw-navbar" data-navbar>

        <button class="close-btn" aria-label="close menu" data-nav-toggler>
          <ion-icon name="close-outline" aria-hidden="true"></ion-icon>
        </button>

        <a href="#" class="logo">
          <img src="~/assets/images/logo.png" width="160" height="50" alt="Arrisd - Home">
        </a>

        <ul class="navbar-list">
          <li class="navbar-item">
            @if (currentPath.Contains("/home") || currentPath == "/")
            {
              <a href="#home" class="navbar-link hover-underline active">
                <div class="separator"></div>
                <span class="span">Home</span>
              </a>
            }
            else
            {
              <a asp-controller="Home" asp-action="Index" class="navbar-link hover-underline">
                <div class="separator"></div>
                <span class="span">Home</span>
              </a>
            }
          </li>

          <li class="navbar-item">
            @if (currentPath.Contains("/home") || currentPath == "/")
            {
              <a href="#menu" class="navbar-link hover-underline">
                <div class="separator"></div>
                <span class="span">Products</span>
              </a>
            }
            else
            {
              <a asp-controller="Products" asp-action="Index" asp-route-area="User" class="navbar-link hover-underline">
                <div class="separator"></div>
                <span class="span">Products</span>
              </a>
            }
          </li>

          <li class="navbar-item">
            @if (currentPath.Contains("/home") || currentPath == "/")
            {
              <a href="#about" class="navbar-link hover-underline">
                <div class="separator"></div>
                <span class="span">About Us</span>
              </a>
            }
            else
            {
              <a asp-controller="Home" asp-action="Index" asp-fragment="about" class="navbar-link hover-underline">
                <div class="separator"></div>
                <span class="span">About Us</span>
              </a>
            }
          </li>

          <li class="navbar-item">
            @if (currentPath.Contains("/home") || currentPath == "/")
            {
              <a href="#reservation" class="navbar-link hover-underline">
                <div class="separator"></div>
                <span class="span">Contact</span>
              </a>
            }
            else
            {
              <a asp-controller="Home" asp-action="Index" asp-fragment="reservation" class="navbar-link hover-underline">
                <div class="separator"></div>
                <span class="span">Contact</span>
              </a>
            }
          </li>

          <li class="navbar-item">
            <a asp-controller="Cart" asp-action="Index" class="navbar-link hover-underline">
              <div class="separator"></div>
              <span class="span">Cart</span>
            </a>
          </li>

          <li class="navbar-item">
            <a asp-controller="Order" asp-action="Index" class="navbar-link hover-underline">
              <div class="separator"></div>
              <span class="span">Order</span>
            </a>
          </li>

        </ul>

        <div class="cw-text-center">
          <p class="headline-1 navbar-title">Visit Us</p>

          <address class="body-4">
            Da Nang City, <br>
            Vietnam
          </address>

          <p class="body-4 navbar-text">Open: 9.30 am - 2.30pm</p>

          <a href="mailto:Order@arrisd.com" class="body-4 sidebar-link">Order@arrisd.com</a>

          <div class="separator"></div>

          <p class="contact-label">Order Request</p>

          <a href="tel:+88123123456" class="body-1 contact-number hover-underline">
            +88-123-123456
          </a>
        </div>

      </nav>
      @if (User.Identity?.IsAuthenticated == true)
      {
        <div class="user-dropdown">
          <img src="@avatarUrl" alt="@currentUser?.UserName" class="user-avatar" id="userAvatar" />
          <div class="user-menu" id="userMenu">
            <div class="user-info">
              <img src="@avatarUrl" class="menu-avatar" />
              <div class="user-details">
                <div class="username">@currentUser?.UserName</div>
                <small>My Account</small>
              </div>
            </div>

            <a asp-controller="User" asp-action="Profile">Profile</a>
            <a asp-controller="User" asp-action="ChangePassword">Change Password</a>

            <div class="divider"></div>

            <a asp-controller="User" asp-action="Logout" class="logout">Logout</a>
          </div>
        </div>
      }
      else
      {
        <a class="cw-btn btn-secondary" asp-action="Login" asp-controller="User">
          <span class="text text-1">Login</span>
          <span class="text text-2" aria-hidden="true" data-text="Login">Login</span>
        </a>
      }

      <button class="nav-open-btn" aria-label="open menu" data-nav-toggler>
        <span class="line line-1"></span>
        <span class="line line-2"></span>
        <span class="line line-3"></span>
      </button>

      <div class="overlay" data-nav-toggler data-overlay></div>

    </div>
  </header>
  @RenderBody()

  <footer class="footer section has-bg-image cw-text-center"
    style="background-image: url('./assets/images/footer-bg.png'); margin-top: 50px; background-color: #121212;">
    <div class="cw-container">

      <div class="footer-top grid-list">

        <div class="footer-brand has-before has-after">

          <a href="#" class="logo">
            <img src="~/assets/images/logo.png" width="160" height="50" loading="lazy" alt="Shoes Shop">
          </a>

          <address class="body-4">
            Ngo Quyen St, Da Nang City, Vietnam
          </address>

          <a href="mailto:booking@arrisd.com" class="body-4 contact-link">booking@arrisd.com</a>

          <a href="tel:+88123123456" class="body-4 contact-link">Booking Request : +88-123-123456</a>

          <p class="body-4">
            Open : 09:00 am - 01:00 pm
          </p>

          <div class="wrapper">
            <div class="separator"></div>
            <div class="separator"></div>
            <div class="separator"></div>
          </div>

          <p class="title-1">Get News & Offers</p>

          <p class="label-1">
            Subscribe us & Get <span class="span">25% Off.</span>
          </p>

          <form action="" class="input-wrapper">
            <div class="icon-wrapper">
              <ion-icon name="mail-outline" aria-hidden="true"></ion-icon>

              <input type="email" name="email_address" placeholder="Your email" autocomplete="off" class="input-field"
                style="display: block;">
            </div>

            <button type="submit" class="cw-btn btn-secondary">
              <span class="text text-1">Subscribe</span>

              <span class="text text-2" aria-hidden="true">Subscribe</span>
            </button>
          </form>

        </div>

        <ul class="footer-list">

          <li>
            <a href="#" class="label-2 footer-link hover-underline">Home</a>
          </li>

          <li>
            <a href="#" class="label-2 footer-link hover-underline">Shop</a>
          </li>

          <li>
            <a href="#" class="label-2 footer-link hover-underline">About Us</a>
          </li>

          <li>
            <a href="#" class="label-2 footer-link hover-underline">Contact</a>
          </li>

          <li>
            <a href="#" class="label-2 footer-link hover-underline">Cart</a>
          </li>

        </ul>

        <ul class="footer-list">

          <li>
            <a href="#" class="label-2 footer-link hover-underline">Facebook</a>
          </li>

          <li>
            <a href="#" class="label-2 footer-link hover-underline">Instagram</a>
          </li>

          <li>
            <a href="#" class="label-2 footer-link hover-underline">Twitter</a>
          </li>

          <li>
            <a href="#" class="label-2 footer-link hover-underline">Youtube</a>
          </li>

          <li>
            <a href="#" class="label-2 footer-link hover-underline">Google Map</a>
          </li>

        </ul>

      </div>

      <div class="footer-bottom">

        <p class="copyright">
          &copy; 2025 Arrisd. All Rights Reserved | Crafted by <a href="https://github.com/DuyHoang104" target="_blank"
            class="link">DuyHoang</a>
        </p>

      </div>

    </div>
  </footer>

  <a href="#top" class="back-top-btn active" aria-label="back to top" data-back-top-btn>
    <ion-icon name="chevron-up" aria-hidden="true"></ion-icon>
  </a>

  <script src="~/assets/js/main.js"></script>
  <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
  <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>

  @RenderSection("Scripts", required: false)
</body>
</html>
<style>
.user-dropdown { position: relative; display: inline-block; }
.user-avatar { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; cursor: pointer; border: 2px solid #2c2c2c; transition: transform 0.2s, box-shadow 0.2s; }
.user-avatar:hover { transform: scale(1.05); box-shadow: 0 0 0 2px #555; }
.user-menu { position: absolute; right: 0; top: 54px; width: 230px; background: #1e1e1e; border-radius: 12px; box-shadow: 0 12px 30px rgba(0,0,0,.8); display: none; z-index: 9999; overflow: hidden; animation: fadeIn 0.2s ease; }
@@keyframes fadeIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
.user-info { display: flex; gap: 12px; padding: 14px; border-bottom: 1px solid #2f2f2f; }
.menu-avatar { width: 38px; height: 38px; border-radius: 50%; }
.user-details .username { color: #fff; font-weight: 600; }
.user-details small { color: #aaa; }
.user-menu a { display: block; padding: 12px 16px; color: #ddd; text-decoration: none; font-size: 14px; transition: background 0.2s, color 0.2s; }
.user-menu a:hover { background: #2a2a2a; color: #fff; }
.divider { height: 1px; background: #2f2f2f; margin: 6px 0; }
.user-menu .logout { color: #ff5c5c; font-weight: 600; }
.user-menu .logout:hover { background: rgba(255,92,92,0.15); }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const avatar = document.getElementById("userAvatar");
    const menu = document.getElementById("userMenu");

    if (!avatar || !menu) return;

    avatar.addEventListener("click", e => {
      e.stopPropagation();
      menu.style.display =
        menu.style.display === "block" ? "none" : "block";
    });

    document.addEventListener("click", () => {
      menu.style.display = "none";
    });
  });
</script>