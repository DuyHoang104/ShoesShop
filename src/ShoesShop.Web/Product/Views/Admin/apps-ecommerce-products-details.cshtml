@using Microsoft.Extensions.Options
@using ShoesShop.Domain.Products.Enums
@using ShoesShop.Web.Product.Model.Admin
@model ProductAdminDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject IOptions<CloudinarySettings> CloudinaryConfig

@{
ViewData["Title"] = "Products";
Layout = "~/Shares/Views/Admin/_LayoutAdmin.cshtml";
}

<style>
.size-option { display:inline-flex; justify-content:center; align-items:center; position:relative; padding:8px 14px; border-radius:50%; border:2px solid #007bff; background-color:#f8f9ff; color:#007bff; font-weight:500; cursor:pointer; user-select:none; width:45px; height:45px; font-size:14px; transition:all 0.3s ease; box-shadow:0 2px 5px rgba(0,0,0,0.05); }
.size-option:hover:not(.disabled) { background-color:#007bff; color:white; transform:scale(1.1); }
.size-option.selected { background-color:#007bff; color:white; box-shadow:0 0 10px rgba(0,123,255,0.6); transform:scale(1.1); }
.size-option.disabled { background-color:#e0e0e0; color:#007bff; cursor:not-allowed; }
.size-option.disabled .cross { position:absolute; font-size:12px; color:red; top:50%; left:50%; transform:translate(-50%,-50%); pointer-events:none; }
.review_list {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.review_item {
    background: #ffffff;
    border: 1px solid #e7eaf0;
    border-radius: 12px;
    padding: 16px 18px;
    transition: box-shadow .25s ease, transform .25s ease;
}

.review_item:hover {
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
}

.review_item .media {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
}

.review_item .media-body h4 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: #2d3748;
}

.review_item .media-body i.fa {
    color: #f6c343;
    margin-right: 2px;
    font-size: 14px;
}

.review_item p {
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: #4a5568;
}

.review_item img[alt="Review image"] {
    background: #f8fafc;
}

.review_item img[alt="Review image"]:hover {
    box-shadow: 0 8px 20px rgba(0,0,0,.25);
}

.review_list > p {
    font-size: 14px;
    color: #718096;
    padding: 12px;
    background: #f8fafc;
    border-radius: 8px;
    border: 1px dashed #cbd5e0;
}

body.dark-mode .review_item {
    background: #1f2933;
}

body.dark-mode .review_item p,
body.dark-mode .review_item h4 {
    color: #e2e8f0;
}
/* =============== END REVIEW SECTION =============== */

</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const sizeOptions = document.querySelectorAll('.size-option');

    sizeOptions.forEach(option => {
        if (!option.classList.contains('disabled')) {
            option.addEventListener('click', () => {
                option.classList.toggle('selected');
            });
        }
    });
});
</script>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="javascript: void(0);">Arrisd</a></li>
                        <li class="breadcrumb-item"><a href="javascript: void(0);">eCommerce</a></li>
                        <li class="breadcrumb-item active">Product Details</li>
                    </ol>
                </div>
                <h4 class="page-title">Product Details</h4>
            </div>
        </div>
    </div>     

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-5">
                            @if (Model.Images != null && Model.Images.Any())
                            {
                                <a href="javascript:void(0);" class="text-center d-block mb-4">
                                    <img src="@Model.Images.First().Url.ToCloudinaryUrl(CloudinaryConfig.Value.BaseUrl)" 
                                        class="img-fluid" style="max-width: 280px;" alt="Product-img">
                                </a>

                                <div class="d-lg-flex d-none justify-content-center flex-wrap gap-2">
                                    @for (int i = 0; i < Model.Images.Count; i++)
                                    {
                                        <a href="javascript:void(0);">
                                            <img src="@Model.Images[i].Url.ToCloudinaryUrl(CloudinaryConfig.Value.BaseUrl)" 
                                                class="img-fluid img-thumbnail p-2" style="max-width: 75px;" alt="Product-img">
                                        </a>
                                    }
                                </div>
                            }
                            else
                            {
                                <p>No images available.</p>
                            }

                        </div>
                        <div class="col-lg-7">
                            <form class="ps-lg-4">
                                <h3 class="mt-0">@Model.Name <a href="javascript: void(0);" class="text-muted"></a> </h3>
                                <p class="mb-1">Added Date: 2025</p>
                                <p class="font-16">
                                    <span class="text-warning mdi mdi-star"></span>
                                    <span class="text-warning mdi mdi-star"></span>
                                    <span class="text-warning mdi mdi-star"></span>
                                    <span class="text-warning mdi mdi-star"></span>
                                    <span class="text-warning mdi mdi-star"></span>
                                </p>

                                <div class="mt-3">
                                    <h4>
                                        <span class="badge badge-success-lighten">@Model.Status</span>
                                            @if (Model.StockStatus == ProductStockStatus.InStock)
                                            {
                                                <span class="badge badge-success-lighten">In Stock</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger-lighten">Out of Stock</span>
                                            }                                
                                    </h4>
                                </div>

                                <div class="mt-4">
                                    <h6 class="font-14">Retail Price:</h6>
                                    <h3> $@Model.Price</h3>
                                </div>
                    
                                <div class="mt-4">
                                    <h6 class="font-14">Description:</h6>
                                    <p>@Model.Description</p>
                                </div>

                                <div class="mt-4">
                                    <h6 class="font-14 mb-2">Available Size:</h6>
                                    <div class="d-flex flex-wrap gap-2">
                                        @{
                                            var allSizes = Enumerable.Range(36, 12).ToList();
                                            var availableSizes = string.IsNullOrWhiteSpace(Model.Sizes)
                                                ? new List<string>()
                                                : Model.Sizes.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                                            .Select(s => s.Trim())
                                                            .ToList();
                                        }

                                        @foreach (var size in allSizes)
                                        {
                                            if (availableSizes.Contains(size.ToString()))
                                            {
                                                <span class="size-option" data-size="@size">@size</span>
                                            }
                                            else
                                            {
                                                <span class="size-option disabled" data-size="@size">
                                                    @size
                                                    <span class="cross">✖</span>
                                                </span>
                                            }
                                        }
                                    </div>
                                </div>

                                <div class="mt-4">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <h6 class="font-14">Available Stock:</h6>
                                            <p class="text-sm lh-150">@Model.Quantity</p>
                                        </div>
                                        <div class="col-md-4">
                                            <h6 class="font-14">Quantity:</h6>
                                            <p class="text-sm lh-150">@Model.Quantity</p>
                                        </div>
                                        <div class="col-md-4">
                                            <h6 class="font-14">Categories:</h6>
                                            <p class="text-sm lh-150">
                                                @foreach (var c in Model.Categories)
                                                {
                                                    @c.Name <br />
                                                }
                                            </p>
                                        </div>
                                    </div>
                                </div>

                            </form>
                        </div>
                    </div>                
                </div>
            </div>
        </div>
    </div>

    <div class="review_list">
        @if (Model.Reviews != null && Model.Reviews.Any())
        {
            foreach (var review in Model.Reviews)
            {
                var avatarUrl = review.User?.AvatarUrl;
                if (!string.IsNullOrEmpty(avatarUrl) && !avatarUrl.StartsWith("http"))
                {
                    avatarUrl = $"{CloudinaryConfig.Value.BaseUrl}{avatarUrl}";
                }

                <div class="review_item">
                    <div class="media">
                        <div class="d-flex">
                            <img src="@(avatarUrl ?? "/images/default-avatar.png")"
                                alt="User"
                                style="width:48px;height:48px;border-radius:50%;object-fit:cover;" />
                        </div>

                        <div class="media-body">
                            <h4>@(review.User?.UserName ?? "Anonymous")</h4>

                            @for (int i = 0; i < review.Rating; i++)
                            {
                                <i class="fa fa-star"></i>
                            }
                            @for (int i = review.Rating; i < 5; i++)
                            {
                                <i class="fa fa-star-o"></i>
                            }
                        </div>
                    </div>

                    <p>@review.Comment</p>

                    @if (review.ProductReview?.Any() == true)
                    {
                        var pr = review.ProductReview.FirstOrDefault();

                        if (pr?.ImageUrls?.Any() == true)
                        {
                            <div style="display:flex;gap:8px;margin-top:8px;flex-wrap:wrap;">
                                @foreach (var img in pr.ImageUrls)
                                {
                                    var fullUrl = img.StartsWith("http")
                                        ? img
                                        : img.ToCloudinaryUrl(CloudinaryConfig.Value.BaseUrl);

                                    <img src="@fullUrl"
                                        alt="Review image"
                                        onclick="openImgZoom('@fullUrl')"
                                        style="
                                            width:72px;
                                            height:72px;
                                            object-fit:cover;
                                            border-radius:8px;
                                            border:1px solid rgba(255,255,255,.1);
                                            cursor:zoom-in;
                                            background:#111;
                                            transition:transform .2s ease, box-shadow .2s ease;"
                                        onmouseover="this.style.transform='scale(1.08)';this.style.boxShadow='0 6px 16px rgba(0,0,0,.35)'"
                                        onmouseout="this.style.transform='scale(1)';this.style.boxShadow='none'" />
                                }
                            </div>
                        }
                    }
                </div>
            }
        }
        else
        {
            <p>No reviews yet.</p>
        }
    </div>
</div>
