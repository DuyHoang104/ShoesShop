@using ShoesShop.Domain.Users.Enums
@using ShoesShop.Web.User.Dtos.Commands.Admin
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model List<UserDto>
@inject Microsoft.Extensions.Options.IOptions<CloudinarySettings> CloudinaryConfig

@{
    ViewData["Title"] = "Customers";
    Layout = "~/Shares/Views/Admin/_LayoutAdmin.cshtml";
}

<link href="~/assets/Admin/css/vendor/dataTables.bootstrap5.css" rel="stylesheet" type="text/css">
<link href="~/assets/Admin/css/vendor/responsive.bootstrap5.css" rel="stylesheet" type="text/css">

<div class="container-fluid">

    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="javascript:void(0);">Arrisd</a></li>
                        <li class="breadcrumb-item"><a href="javascript:void(0);">eCommerce</a></li>
                        <li class="breadcrumb-item active">Customers</li>
                    </ol>
                </div>
                <h4 class="page-title">Customers</h4>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">

                    <div class="row mb-2">
                        <div class="col-sm-4">
                            <a href="javascript:void(0);" class="btn btn-danger mb-2"><i
                                    class="mdi mdi-plus-circle me-2"></i> Add Customers</a>
                        </div>
                        <div class="col-sm-8">
                            <div class="text-sm-end">
                                <button type="button" class="btn btn-success mb-2 me-1"><i
                                        class="mdi mdi-cog"></i></button>
                                <button type="button" class="btn btn-light mb-2 me-1">Import</button>
                                <button type="button" class="btn btn-light mb-2">Export</button>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-centered table-striped dt-responsive nowrap w-100"
                            id="products-datatable">
                            <thead>
                                <tr>
                                    <th style="width: 20px;">
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" id="customCheck1">
                                            <label class="form-check-label" for="customCheck1">&nbsp;</label>
                                        </div>
                                    </th>
                                    <th>Customer</th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th>Location</th>
                                    <th>Date of Birth</th>
                                    <th>Status</th>
                                    <th style="width: 75px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model)
                                {
                                    var baseUrl = CloudinaryConfig.Value.BaseUrl.EndsWith("/") ?
                                    CloudinaryConfig.Value.BaseUrl : $"{CloudinaryConfig.Value.BaseUrl}/";
                                    var imgUrl = !string.IsNullOrEmpty(user.AvatarUrl)
                                    ? (user.AvatarUrl.StartsWith("http") ? user.AvatarUrl : $"{baseUrl}{user.AvatarUrl}")
                                    : "/images/default.png";

                                    <tr>
                                        <td>
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="customCheck2">
                                                <label class="form-check-label" for="customCheck2">&nbsp;</label>
                                            </div>
                                        </td>
                                        <td class="table-user">
                                            <img src="@imgUrl" alt="table-user" class="me-2 rounded-circle">
                                            <a class="text-body fw-semibold" asp-controller="Admin" asp-action="Details"
                                                asp-route-id="@user.ID">
                                                @user.UserName
                                            </a>
                                        </td>
                                        <td>@user.Phone</td>
                                        <td>@user.Email</td>
                                        <td>@user.Addresses.FirstOrDefault()?.City</td>
                                        <td>@user.DateOfBirth.ToString("MM/dd/yyyy")</td>
                                        <td>
                                            <span class="badge @GetBadgeClass(user.Status)">@user.Status</span>
                                        </td>
                                        <td>
                                            <a href="javascript:void(0);" class="action-icon edit-status-btn"
                                                data-user-id="@user.ID" data-current-status="@user.Status">
                                                <i class="mdi mdi-square-edit-outline"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/assets/Admin/js/vendor/jquery.dataTables.min.js"></script>
    <script src="~/assets/Admin/js/vendor/dataTables.bootstrap5.js"></script>
    <script src="~/assets/Admin/js/vendor/dataTables.responsive.min.js"></script>
    <script src="~/assets/Admin/js/vendor/responsive.bootstrap5.min.js"></script>
    <script src="~/assets/Admin/js/vendor/dataTables.checkboxes.min.js"></script>
    <script src="~/assets/Admin/js/pages/demo.customers.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const editButtons = document.querySelectorAll(".edit-status-btn");

            let optionsHtml = '';
                                            @foreach (var status in Enum.GetValues(typeof(UserStatus)))
                {
                    var statusStr = status.ToString();
                    <text>optionsHtml += `<option value="@statusStr">@statusStr</option>`;</text>
            }

                editButtons.forEach(btn => {
                    btn.addEventListener("click", function () {
                        const userId = this.getAttribute("data-user-id");
                        const currentStatus = this.getAttribute("data-current-status");
                        const row = this.closest("tr");

                        Swal.fire({
                            title: 'Edit User Status',
                            html: 
                            `
                                <select id="swal-status" class="swal2-input-small mb-3">
                                    ${optionsHtml}
                                </select>
                                <div class="d-flex justify-content-between">
                                    <button id="swal-save-btn" class="btn btn-primary btn-sm">Save</button>
                                    <button id="swal-cancel-btn" class="btn btn-secondary btn-sm">Cancel</button>
                                </div>
                            `,
                            didOpen: () => {
                                document.getElementById('swal-status').value = currentStatus;

                                document.getElementById('swal-save-btn').addEventListener('click', () => {
                                    const newStatus = document.getElementById('swal-status').value;

                                    const formData = new FormData();
                                    formData.append("newStatus", newStatus);

                                    fetch(`/Admin/UpdateStatus/${userId}`, {
                                        method: 'POST',
                                        headers: {
                                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                                        },
                                        body: formData
                                    })
                                        .then(res => res.json())
                                        .then(data => {
                                            if (data.success) {
                                                Swal.close();
                                                const badge = row.querySelector("td:nth-child(7) span");
                                                badge.textContent = newStatus;
                                                badge.className = `badge ${getBadgeClassJS(newStatus)}`;

                                                Swal.fire({
                                                    icon: 'success',
                                                    title: 'Updated!',
                                                    text: data.message,
                                                    customClass: {
                                                        title: 'swal2-title-small',
                                                        content: 'swal2-text-small',
                                                        popup: 'swal2-popup-small swal-shadow-popup'
                                                    },
                                                    timer: 1200,
                                                    showConfirmButton: false
                                                });
                                            } else {
                                                Swal.fire('Error', data.message, 'error');
                                            }
                                        })
                                        .catch(err => {
                                            console.error(err);
                                            Swal.fire('Error', 'Something went wrong.', 'error');
                                        });
                                });

                                document.getElementById('swal-cancel-btn').addEventListener('click', () => Swal.close());
                            },
                            showConfirmButton: false,
                            width: 350
                        });
                    });
                });

            function getBadgeClassJS(status) {
                switch (status) {
                    case 'Active': return 'badge-success-lighten';
                    case 'InActive': return 'badge-secondary-lighten';
                    case 'InConfirm': return 'badge-danger-lighten';
                    case 'Banned': return 'badge-danger-lighten';
                    default: return 'badge-info-lighten';
                }
            }
        });
    </script>
}

@functions {
    private string GetBadgeClass(UserStatus status)
    {
        return status switch
        {
            UserStatus.InConfirm => "badge badge-warning-lighten",
            UserStatus.Active => "badge badge-success-lighten",
            UserStatus.InActive => "badge badge-secondary-lighten",
            UserStatus.Banned => "badge badge-danger-lighten",
            _ => "badge badge-info-lighten"
        };
    }
}
<style>
.swal2-title-small { font-size: 0.85rem !important; font-weight: 600; }
.swal2-text-small { font-size: 0.8rem !important; }
.swal2-popup-small { font-size: 0.85rem !important; }
.swal2-input-small { font-size: 0.8rem !important; padding: 0.3em; width: 100%; border-radius: 0.25rem; border: 1px solid #ced4da; }
.swal-shadow-popup { border-radius: 0.6rem !important; box-shadow: 0 0.7rem 1.5rem rgba(0,0,0,0.2); }
td span.badge { font-size: 0.75rem; padding: 0.2em 0.5em; min-width: 80px; display: inline-block; text-align: center; border-radius: 0.25rem; }
.btn-sm { font-size: 0.75rem; padding: 0.25rem 0.5rem; }
</style>
