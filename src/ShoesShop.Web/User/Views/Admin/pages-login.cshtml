@using ShoesShop.Web.User.Dtos.Commands.Admin
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model LoginDto

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>Log In | Admin Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="shortcut icon" href="~/assets/Admin/images/favicon.ico">
    <link href="~/assets/Admin/css/icons.min.css" rel="stylesheet" />
    <link href="~/assets/Admin/css/app.min.css" rel="stylesheet" id="light-style" />
    <link href="~/assets/Admin/css/app-dark.min.css" rel="stylesheet" id="dark-style" />
</head>

<body class="loading authentication-bg">

    <div class="account-pages pt-2 pt-sm-5 pb-4 pb-sm-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-xxl-4 col-lg-5">
                    <div class="card">

                        <div class="card-header pt-4 pb-4 text-center bg-primary">
                            <img src="~/assets/Admin/images/logo.png" height="18" />
                        </div>

                        <div class="card-body p-4">

                            <div class="text-center w-75 m-auto">
                                <h4 class="text-dark-50 fw-bold">Sign In</h4>
                                <p class="text-muted mb-4">
                                    Enter your username and password to access admin panel.
                                </p>
                            </div>

                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <form asp-action="Login" asp-controller="Admin" method="POST">
                                @Html.AntiForgeryToken()

                                <!-- Username -->
                                <div class="mb-3">
                                    <label asp-for="UserName" class="form-label"></label>
                                    <input asp-for="UserName" class="form-control" />
                                    <span asp-validation-for="UserName" class="text-danger"></span>
                                </div>

                                <!-- Password -->
                                <div class="mb-3">
                                    <label asp-for="Password" class="form-label"></label>
                                    <div class="input-group input-group-merge">
                                        <input asp-for="Password" type="password" class="form-control" />
                                        <div class="input-group-text">
                                            <span class="password-eye"></span>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>

                                <div class="mb-3 text-center">
                                    <button class="btn btn-primary w-100" type="submit">
                                        Log In
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="footer footer-alt">
        2024–2025 © ShoesShop - Arrisd
    </footer>

    <script src="~/assets/Admin/js/vendor.min.js"></script>
    <script src="~/assets/Admin/js/app.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>

</html>